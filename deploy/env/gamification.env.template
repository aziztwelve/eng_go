# ----------------------------
# Gamification Service Configuration
# ----------------------------
# Этот файл генерируется автоматически из .env
# НЕ редактируйте вручную!
# ----------------------------

# gRPC Server
GRPC_HOST=${GAMIFICATION_GRPC_HOST}
GRPC_PORT=${GAMIFICATION_GRPC_PORT}

# Logger
LOGGER_LEVEL=${GAMIFICATION_LOGGER_LEVEL}
LOGGER_AS_JSON=${GAMIFICATION_LOGGER_AS_JSON}

# PostgreSQL
POSTGRES_HOST=${GAMIFICATION_POSTGRES_HOST}
POSTGRES_PORT=${GAMIFICATION_POSTGRES_PORT}
POSTGRES_DB=${GAMIFICATION_POSTGRES_DB}
POSTGRES_SCHEMA=${GAMIFICATION_POSTGRES_SCHEMA}
POSTGRES_USER=${GAMIFICATION_POSTGRES_USER}
POSTGRES_PASSWORD=${GAMIFICATION_POSTGRES_PASSWORD}

# Business rules
HEART_REGEN_INTERVAL=${GAMIFICATION_HEART_REGEN_INTERVAL}
MAX_HEARTS=${GAMIFICATION_MAX_HEARTS}
DEFAULT_DAILY_XP=${GAMIFICATION_DEFAULT_DAILY_XP}
STREAK_FREEZE_MAX=${GAMIFICATION_STREAK_FREEZE_MAX}

# Cron
CRON_HEARTS_EVERY=${GAMIFICATION_CRON_HEARTS_EVERY}
CRON_STREAK_DAILY=${GAMIFICATION_CRON_STREAK_DAILY}

# Phase 4 — Kafka producer (xp.gained events для social-service).
# Если KAFKA_BROKERS пуст — producer-no-op, AddXP не валится.
KAFKA_BROKERS=${GAMIFICATION_KAFKA_BROKERS}
KAFKA_TOPIC_XP_GAINED=${GAMIFICATION_KAFKA_TOPIC_XP_GAINED}
