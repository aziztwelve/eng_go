# Quota — суточные лимиты free / premium плана. -1 = unlimited.
AI_FREE_CHAT_LIMIT=${AI_FREE_CHAT_LIMIT}
AI_FREE_VOICE_MINUTES_LIMIT=${AI_FREE_VOICE_MINUTES_LIMIT}
AI_FREE_WRITING_LIMIT=${AI_FREE_WRITING_LIMIT}
AI_PREMIUM_CHAT_LIMIT=${AI_PREMIUM_CHAT_LIMIT}
AI_PREMIUM_VOICE_MINUTES_LIMIT=${AI_PREMIUM_VOICE_MINUTES_LIMIT}
