AI_ANTHROPIC_API_KEY=${AI_ANTHROPIC_API_KEY}
AI_ANTHROPIC_BASE_URL=${AI_ANTHROPIC_BASE_URL}
AI_ANTHROPIC_MODEL=${AI_ANTHROPIC_MODEL}
AI_DEFAULT_MODEL_CHAT=${AI_DEFAULT_MODEL_CHAT}
AI_DEFAULT_MODEL_HEAVY=${AI_DEFAULT_MODEL_HEAVY}

# Hybrid routing.
AI_HEAVY_LANGUAGES=${AI_HEAVY_LANGUAGES}

# TTS / STT.
AI_TTS_MODEL=${AI_TTS_MODEL}
AI_TTS_VOICE=${AI_TTS_VOICE}
AI_WHISPER_MODEL=${AI_WHISPER_MODEL}
