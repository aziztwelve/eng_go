# gRPC Server
GRPC_HOST=${AI_GRPC_HOST}
GRPC_PORT=${AI_GRPC_PORT}

# Logger
LOGGER_LEVEL=${AI_LOGGER_LEVEL}
LOGGER_AS_JSON=${AI_LOGGER_AS_JSON}

# PostgreSQL
POSTGRES_HOST=${AI_POSTGRES_HOST}
POSTGRES_PORT=${AI_POSTGRES_PORT}
POSTGRES_DB=${AI_POSTGRES_DB}
POSTGRES_SCHEMA=${AI_POSTGRES_SCHEMA}
POSTGRES_USER=${AI_POSTGRES_USER}
POSTGRES_PASSWORD=${AI_POSTGRES_PASSWORD}

# Provider: mock | openai | anthropic | router.
AI_PROVIDER=${AI_PROVIDER}
AI_OPENAI_API_KEY=${AI_OPENAI_API_KEY}
