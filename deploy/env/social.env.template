# ----------------------------
# Social Service Configuration (Phase 4 — Leagues / Cohorts / Leaderboards)
# ----------------------------
# Этот файл генерируется автоматически из .env
# НЕ редактируйте вручную!
# ----------------------------

# gRPC Server
GRPC_HOST=${SOCIAL_GRPC_HOST}
GRPC_PORT=${SOCIAL_GRPC_PORT}

# Logger
LOGGER_LEVEL=${SOCIAL_LOGGER_LEVEL}
LOGGER_AS_JSON=${SOCIAL_LOGGER_AS_JSON}

# PostgreSQL
POSTGRES_HOST=${SOCIAL_POSTGRES_HOST}
POSTGRES_PORT=${SOCIAL_POSTGRES_PORT}
POSTGRES_DB=${SOCIAL_POSTGRES_DB}
POSTGRES_SCHEMA=${SOCIAL_POSTGRES_SCHEMA}
POSTGRES_USER=${SOCIAL_POSTGRES_USER}
POSTGRES_PASSWORD=${SOCIAL_POSTGRES_PASSWORD}

# Redis (leaderboard sorted sets)
REDIS_ADDR=${SOCIAL_REDIS_ADDR}
REDIS_DB=${SOCIAL_REDIS_DB}
REDIS_PASSWORD=${SOCIAL_REDIS_PASSWORD}

# Kafka consumer (xp.gained)
KAFKA_BROKERS=${SOCIAL_KAFKA_BROKERS}
KAFKA_TOPIC_XP_GAINED=${SOCIAL_KAFKA_TOPIC_XP_GAINED}
KAFKA_GROUP_ID=${SOCIAL_KAFKA_GROUP_ID}

# Dependencies
USER_SERVICE_ADDR=${SOCIAL_USER_SERVICE_ADDR}
AUTH_SERVICE_ADDR=${SOCIAL_AUTH_SERVICE_ADDR}
NOTIFICATIONS_SERVICE_ADDR=${SOCIAL_NOTIFICATIONS_SERVICE_ADDR}

# Cron schedules (UTC)
CRON_WEEKLY_ROTATION=${SOCIAL_CRON_WEEKLY_ROTATION}
CRON_RANK_SNAPSHOT_EVERY=${SOCIAL_CRON_RANK_SNAPSHOT_EVERY}
