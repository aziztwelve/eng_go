# ----------------------------
# Notifications Service Configuration (Phase 3 — Push notifications)
# ----------------------------
# Этот файл генерируется автоматически из .env
# НЕ редактируйте вручную!
# ----------------------------

# gRPC Server
GRPC_HOST=${NOTIFICATIONS_GRPC_HOST}
GRPC_PORT=${NOTIFICATIONS_GRPC_PORT}

# Logger
LOGGER_LEVEL=${NOTIFICATIONS_LOGGER_LEVEL}
LOGGER_AS_JSON=${NOTIFICATIONS_LOGGER_AS_JSON}

# PostgreSQL
POSTGRES_HOST=${NOTIFICATIONS_POSTGRES_HOST}
POSTGRES_PORT=${NOTIFICATIONS_POSTGRES_PORT}
POSTGRES_DB=${NOTIFICATIONS_POSTGRES_DB}
POSTGRES_SCHEMA=${NOTIFICATIONS_POSTGRES_SCHEMA}
POSTGRES_USER=${NOTIFICATIONS_POSTGRES_USER}
POSTGRES_PASSWORD=${NOTIFICATIONS_POSTGRES_PASSWORD}

# Web Push (VAPID). Если оба ключа пустые — Web Push доставка отключена.
# Сгенерировать: `npx web-push generate-vapid-keys` (Node) или `task notifications:vapid`.
VAPID_PUBLIC_KEY=${NOTIFICATIONS_VAPID_PUBLIC_KEY}
VAPID_PRIVATE_KEY=${NOTIFICATIONS_VAPID_PRIVATE_KEY}
VAPID_SUBJECT=${NOTIFICATIONS_VAPID_SUBJECT}

# Expo Push API URL.
EXPO_PUSH_API=${NOTIFICATIONS_EXPO_PUSH_API}

# Если true — реальная доставка отключена (всё пишется в лог как sent).
PUSH_DRY_RUN=${NOTIFICATIONS_PUSH_DRY_RUN}
