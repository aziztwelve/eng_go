                ]
              },
              "match_pairs": {
                "pairs": [
                  {
                    "left": "Hello",
                    "right": "Привет"
                  },
                  {
                    "left": "Goodbye",
                    "right": "Пока"
                  }
                ]
              },
              "listening": {
                "audio_url": "https://...",
                "duration_seconds": 60,
                "text": "Expected transcription",
                "hint": "Listen carefully"
              },
              "quiz": {
                "question": "What is the correct greeting?",
                "options": [
                  {
                    "text": "Hello",
                    "is_correct": true
                  },
                  {
                    "text": "Goodbye",
                    "is_correct": false
                  }
                ],
                "explanation": "Hello is a greeting"
              },
              "story": {
                "title": "Story title",
                "scenes": [
                  {
                    "text": "Once upon a time...",
                    "image_url": "https://...",
                    "audio_url": "https://..."
                  }
                ]
              },
              "tap_words": {
                "prompt": "Tap the words in order: How are you?",
                "words": ["How", "are", "you", "?"],
                "distractors": ["I", "am", "fine"]
              },
              "ai_writing": {
                "prompt": "Write a short introduction about yourself",
                "min_words": 50,
                "topic": "introduction",
                "rubric": ["grammar", "vocabulary", "coherence"]
              }
            }
          }
        ]
      }
