{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingoiq.online/schemas/track-import-v2.json",
  "title": "LingoIQ Track Import v2",
  "type": "object",
  "required": ["schema_version", "track", "lessons"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "lingoiq.track.v2" },
    "track": { "$ref": "#/$defs/track" },
    "lessons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lesson" } }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": { "ru": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "track": {
      "type": "object",
      "required": ["code", "title", "description", "target_language", "native_language", "level", "goal", "track_type"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_-]+$" },
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "target_language": { "type": "string", "pattern": "^[a-z]{2,3}$" },
        "native_language": { "type": "string", "pattern": "^[a-z]{2,3}$" },
        "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
        "goal": { "type": "string", "minLength": 1 },
        "track_type": { "enum": ["thematic", "daily", "stories", "podcast"] }
      }
    },
    "lesson": {
      "type": "object",
      "required": ["code", "order", "title", "objective", "estimated_seconds", "steps"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_-]+$" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/localizedText" },
        "objective": { "$ref": "#/$defs/localizedText" },
        "estimated_seconds": { "type": "integer", "minimum": 30 },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "order", "type", "title", "instructions", "estimated_seconds", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "order": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["video", "text", "quiz", "translate", "match_pairs", "match_pairs_voice", "listening", "listening_shadowing", "fill_blank", "tap_words", "story", "choose_definition", "listen_choose_word", "missing_word", "complete_chat", "task", "brain_game", "ai_writing", "activity"] },
        "title": { "$ref": "#/$defs/localizedText" },
        "instructions": { "$ref": "#/$defs/localizedText" },
        "estimated_seconds": { "type": "integer", "minimum": 5 },
        "data": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "video" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/video" } } } },
        { "if": { "properties": { "type": { "const": "text" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/text" } } } },
        { "if": { "properties": { "type": { "const": "quiz" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/quiz" } } } },
        { "if": { "properties": { "type": { "const": "translate" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/translate" } } } },
        { "if": { "properties": { "type": { "const": "match_pairs" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/matchPairs" } } } },
        { "if": { "properties": { "type": { "const": "match_pairs_voice" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/matchPairsVoice" } } } },
        { "if": { "properties": { "type": { "const": "listening" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/listening" } } } },
        { "if": { "properties": { "type": { "const": "listening_shadowing" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/listeningShadowing" } } } },
        { "if": { "properties": { "type": { "const": "fill_blank" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/fillBlank" } } } },
        { "if": { "properties": { "type": { "const": "tap_words" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/tapWords" } } } },
        { "if": { "properties": { "type": { "const": "story" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/story" } } } },
        { "if": { "properties": { "type": { "const": "choose_definition" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/chooseDefinition" } } } },
        { "if": { "properties": { "type": { "const": "listen_choose_word" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/listenChooseWord" } } } },
        { "if": { "properties": { "type": { "const": "missing_word" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/missingWord" } } } },
        { "if": { "properties": { "type": { "const": "complete_chat" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/completeChat" } } } },
        { "if": { "properties": { "type": { "const": "task" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/task" } } } },
        { "if": { "properties": { "type": { "const": "brain_game" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/brainGame" } } } },
        { "if": { "properties": { "type": { "const": "ai_writing" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/aiWriting" } } } },
        { "if": { "properties": { "type": { "const": "activity" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/activity" } } } }
      ]
    },
    "video": { "type": "object", "required": ["video_id", "duration_seconds"], "additionalProperties": false, "properties": { "video_id": { "type": "string" }, "duration_seconds": { "type": "integer", "minimum": 1 }, "subtitles": { "type": "array", "items": { "type": "string" } } } },
    "text": { "type": "object", "required": ["body", "reading_time_minutes"], "additionalProperties": false, "properties": { "body": { "type": "string", "minLength": 1 }, "reading_time_minutes": { "type": "integer", "minimum": 1 } } },
    "quiz": { "type": "object", "required": ["question", "options", "explanation"], "additionalProperties": false, "properties": { "question": { "type": "string", "minLength": 1 }, "options": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["id", "text", "is_correct"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "is_correct": { "type": "boolean" } } }, "contains": { "properties": { "is_correct": { "const": true } }, "required": ["is_correct"] }, "minContains": 1, "maxContains": 1 }, "explanation": { "type": "string", "minLength": 1 }, "image_url": { "type": "string", "format": "uri" } } },
    "translate": { "type": "object", "required": ["source_text", "source_language", "target_language", "correct_translation", "word_bank"], "additionalProperties": false, "properties": { "source_text": { "type": "string" }, "source_language": { "type": "string" }, "target_language": { "type": "string" }, "correct_translation": { "type": "string" }, "word_bank": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "alternative_answers": { "type": "array", "items": { "type": "string" } }, "hints": { "type": "array", "items": { "type": "string" } }, "explanation": { "type": "string" } } },
    "matchPairs": { "type": "object", "required": ["pairs"], "additionalProperties": false, "properties": { "pairs": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["id", "left", "right"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "left": { "type": "string" }, "right": { "type": "string" }, "audio_url": { "type": "string", "format": "uri" }, "image_url": { "type": "string", "format": "uri" } } } }, "explanation": { "type": "string" } } },
    "matchPairsVoice": { "type": "object", "required": ["language", "pairs"], "additionalProperties": false, "properties": { "language": { "type": "string", "pattern": "^[a-z]{2,3}$" }, "pairs": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["id", "audio_text", "text"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "audio_text": { "type": "string", "minLength": 1 }, "audio_url": { "type": "string", "format": "uri" }, "text": { "type": "string", "minLength": 1 } } } }, "explanation": { "type": "string" } } },
    "listening": { "type": "object", "required": ["audio_text", "language"], "additionalProperties": false, "properties": { "audio_text": { "type": "string", "minLength": 1 }, "language": { "type": "string" }, "audio_url": { "type": "string", "format": "uri" }, "translation_hint": { "type": "string" }, "alternative_answers": { "type": "array", "items": { "type": "string" } } } },
    "listeningShadowing": { "type": "object", "required": ["audio_text", "language", "min_accuracy"], "additionalProperties": false, "properties": { "audio_text": { "type": "string", "minLength": 1 }, "language": { "type": "string", "pattern": "^[a-z]{2,3}$" }, "audio_url": { "type": "string", "format": "uri" }, "min_accuracy": { "type": "number", "minimum": 0, "maximum": 1 }, "translation_hint": { "type": "string" }, "explanation": { "type": "string" } } },
    "fillBlank": { "type": "object", "required": ["sentence_template", "correct_answer"], "additionalProperties": false, "properties": { "sentence_template": { "type": "string", "pattern": "___" }, "correct_answer": { "type": "string", "minLength": 1 }, "options": { "type": "array", "items": { "type": "string" } }, "translation_hint": { "type": "string" }, "alternatives": { "type": "array", "items": { "type": "string" } }, "explanation": { "type": "string" } } },
    "tapWords": { "type": "object", "required": ["word_bank", "correct_words"], "additionalProperties": false, "properties": { "audio_text": { "type": "string" }, "audio_url": { "type": "string", "format": "uri" }, "word_bank": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "correct_words": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "explanation": { "type": "string" } } },
    "story": { "type": "object", "required": ["title", "scenes"], "additionalProperties": false, "properties": { "title": { "type": "string" }, "scenes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type", "text"], "additionalProperties": false, "properties": { "type": { "enum": ["narration", "dialogue", "choice"] }, "character": { "type": "string" }, "text": { "type": "string" }, "translation": { "type": "string" }, "image_url": { "type": "string", "format": "uri" }, "options": { "type": "array", "items": { "type": "object", "required": ["text", "is_correct"], "additionalProperties": false, "properties": { "text": { "type": "string" }, "is_correct": { "type": "boolean" } } } } } } } } },
    "chooseDefinition": { "type": "object", "required": ["word", "options", "explanation"], "additionalProperties": false, "properties": { "word": { "type": "string", "minLength": 1 }, "language": { "type": "string", "pattern": "^[a-z]{2,3}$" }, "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "object", "required": ["id", "text", "is_correct"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 }, "is_correct": { "type": "boolean" } } }, "contains": { "properties": { "is_correct": { "const": true } }, "required": ["is_correct"] }, "minContains": 1, "maxContains": 1 }, "explanation": { "type": "string", "minLength": 1 }, "vocabulary_id": { "type": "string" } } },
    "listenChooseWord": { "type": "object", "required": ["sentence_template", "audio_text", "language", "options", "explanation"], "additionalProperties": false, "properties": { "sentence_template": { "type": "string", "pattern": "___" }, "audio_text": { "type": "string", "minLength": 1 }, "language": { "type": "string", "pattern": "^[a-z]{2,3}$" }, "options": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "object", "required": ["id", "audio_text", "is_correct"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "audio_text": { "type": "string", "minLength": 1 }, "is_correct": { "type": "boolean" } } }, "contains": { "properties": { "is_correct": { "const": true } }, "required": ["is_correct"] }, "minContains": 1, "maxContains": 1 }, "explanation": { "type": "string", "minLength": 1 } } },
    "missingWord": { "type": "object", "required": ["sentence_template", "correct_answer", "hint_prefix", "explanation"], "additionalProperties": false, "properties": { "sentence_template": { "type": "string", "pattern": "___" }, "correct_answer": { "type": "string", "minLength": 2 }, "hint_prefix": { "type": "string", "minLength": 1, "maxLength": 2 }, "explanation": { "type": "string", "minLength": 1 } } },
    "completeChat": { "type": "object", "required": ["dialogue", "options", "explanation"], "additionalProperties": false, "properties": { "dialogue": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["speaker", "text"], "additionalProperties": false, "properties": { "speaker": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } } } }, "answer_speaker": { "type": "string", "minLength": 1 }, "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "object", "required": ["id", "text", "is_correct"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 }, "is_correct": { "type": "boolean" } } }, "contains": { "properties": { "is_correct": { "const": true } }, "required": ["is_correct"] }, "minContains": 1, "maxContains": 1 }, "explanation": { "type": "string", "minLength": 1 } } },
    "task": { "type": "object", "required": ["instructions", "template", "correct_answers"], "additionalProperties": false, "properties": { "instructions": { "type": "string" }, "template": { "type": "string" }, "correct_answers": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "hints": { "type": "array", "items": { "type": "string" } } } },
    "brainGame": { "type": "object", "required": ["game_type", "pairs"], "additionalProperties": false, "properties": { "game_type": { "enum": ["matching", "memory", "flashcards"] }, "pairs": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["word", "translation"], "additionalProperties": false, "properties": { "word": { "type": "string" }, "translation": { "type": "string" } } } } } },
    "aiWriting": { "type": "object", "required": ["prompt", "min_words", "evaluation_criteria"], "additionalProperties": false, "properties": { "prompt": { "type": "string" }, "min_words": { "type": "integer", "minimum": 1 }, "evaluation_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "activity": { "type": "object", "required": ["activity_type"], "additionalProperties": false, "properties": { "activity_type": { "enum": ["repeat_after_me", "pronunciation_drill", "guided_dialogue", "ai_roleplay", "real_world_mission"] }, "models": { "type": "array", "items": { "type": "string" } }, "target_phrases": { "type": "array", "items": { "type": "string" } }, "target_vocabulary": { "type": "array", "items": { "type": "string" } }, "dialogue": { "type": "array", "items": { "type": "object", "required": ["speaker", "text"], "additionalProperties": false, "properties": { "speaker": { "type": "string" }, "text": { "type": "string" } } } }, "scenario": { "type": "string" }, "required_phrases": { "type": "array", "items": { "type": "string" } }, "minimum_seconds": { "type": "integer", "minimum": 1 }, "task": { "type": "string" }, "tip": { "type": "string" } }, "allOf": [ { "if": { "properties": { "activity_type": { "const": "repeat_after_me" } } }, "then": { "required": ["models"] } }, { "if": { "properties": { "activity_type": { "const": "pronunciation_drill" } } }, "then": { "required": ["models", "tip"] } }, { "if": { "properties": { "activity_type": { "const": "guided_dialogue" } } }, "then": { "required": ["dialogue"] } }, { "if": { "properties": { "activity_type": { "const": "ai_roleplay" } } }, "then": { "required": ["scenario", "required_phrases"] } }, { "if": { "properties": { "activity_type": { "const": "real_world_mission" } } }, "then": { "required": ["minimum_seconds", "task"] } } ] }
  }
}
